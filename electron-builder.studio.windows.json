{
  "appId": "app.radiantcursor.studio",
  "productName": "RadiantCursor Studio",
  "asar": true,
  "extraMetadata": {
    "name": "radiantcursor-studio",
    "productName": "RadiantCursor Studio"
  },
  "extraResources": [
    "rcs-icon.png",
    {
      "from": "native/windows/build/Release/RadiantCursor.Runtime.exe",
      "to": "runtime/windows/RadiantCursor.Runtime.exe"
    }
  ],
  "files": [
    "dist/main/**/*",
    "dist/renderer-studio/**/*",
    "package.json",
    "!dist/**/*.map"
  ],
  "directories": {
    "output": "release/radiantcursor-studio-windows"
  },
  "win": {
    "target": ["nsis"],
    "icon": "rcs-icon.png",
    "executableName": "RadiantCursor Studio",
    "artifactName": "RadiantCursor-Studio-${version}-${arch}.${ext}"
  },
  "nsis": {
    "include": "build/windows/installer.nsh",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "electronLanguages": ["pt-BR", "en-US"]
}
